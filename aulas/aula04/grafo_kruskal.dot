graph D {
A [shape="circle"]
B [shape="circle"]
C [shape="circle"]
D [shape="circle"]
E [shape="circle"]

B -- C [label = 1, color="blue"]
A -- B [label = 2, color="blue"]
A -- C [label = 3, color="white"]
B -- D [label = 4, color=blue]
C -- D [label = 5, color="white"]
D -- E [label = 6, color=blue]
C -- E [label = 7, color=white]
}