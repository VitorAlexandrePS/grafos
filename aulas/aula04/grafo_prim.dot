graph D {
A [shape="circle", color="blue"]
B [shape="circle", color="blue"]
C [shape="circle", color="blue"]
D [shape="circle", color="blue"]
E [shape="circle", color="blue"]

A -- B [label = 2, color="blue"]
A -- C [label = 3, color="white"]
B -- C [label = 1, color="blue"]
B -- D [label = 4,color="white"]
C -- D [label = 5, color="blue"]
C -- E [label = 7,color="white"]
D -- E [label = 6, color="blue"]
}